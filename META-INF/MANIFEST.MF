 org.adempiere.print;bundle-version="10.0.0";resolution:=optional,
 org.eclipse.jetty.servlet-api,
 wrapped.io.opencensus.opencensus-api,
 org.compiere.db.postgresql.provider;bundle-version="10.0.0",
 wrapped.org.apache.poi.poi-ooxml,
 com.google.gson;bundle-version="2.9.0",
